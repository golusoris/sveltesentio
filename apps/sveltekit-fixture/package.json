{
	"description": "Private minimal SvelteKit app that the CI self-test runs the reusable .github/workflows/ci-sveltekit.yml against. Verification artifact, not a deployable app.",
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^24.13.4",
		"@vitest/coverage-v8": "^5.0.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vitest": "^5.0.0"
	},
	"license": "EUPL-1.2",
	"name": "@sveltesentio/sveltekit-fixture",
	"private": true,
	"scripts": {
		"build": "vite build",
		"lint": "svelte-kit sync && eslint src/ test/",
		"test": "vitest run",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
	},
	"type": "module",
	"version": "0.0.0"
}
