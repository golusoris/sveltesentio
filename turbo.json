{
	"$schema": "https://turbo.build/schema.json",
	"agentGuidance": false,
	"globalDependencies": [
		"eslint.config.ts",
		"prettier.config.js",
		"tsconfig.base.json",
		"pnpm-workspace.yaml",
		"vitest.shared.ts"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".svelte-kit/**"]
		},
		"lint": {
			"dependsOn": []
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"test": {
			"dependsOn": ["^build"]
		},
		"test:e2e": {
			"dependsOn": ["build"],
			"outputs": ["playwright-report/**", "test-results/**"]
		},
		"dev": {
			"persistent": true,
			"cache": false
		}
	}
}
