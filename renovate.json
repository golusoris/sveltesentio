{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["github>plurano/horistes", "helpers:pinGitHubActionDigests"],
	"internalChecksFilter": "strict",
	"rebaseWhen": "auto",
	"postUpdateOptions": ["pnpmDedupe"],
	"vulnerabilityAlerts": {
		"enabled": true,
		"labels": ["security"],
		"minimumReleaseAge": null,
		"schedule": ["at any time"],
		"vulnerabilityFixStrategy": "highest"
	},
	"lockFileMaintenance": {
		"enabled": true,
		"schedule": ["before 6am on monday"],
		"groupName": "lockfile maintenance"
	},
	"packageRules": [
		{
			"matchUpdateTypes": ["vulnerability"],
			"groupName": null,
			"minimumReleaseAge": null,
			"schedule": ["at any time"],
			"labels": ["security"]
		},
		{
			"matchPackageNames": ["undici"],
			"allowedVersions": "<8",
			"description": "undici 8.x removes internals jsdom 29 requires; stay on patched 7.x"
		},
		{
			"matchPackageNames": ["cookie"],
			"allowedVersions": "<1",
			"description": "cookie 1.x bundles its own types, which take precedence over @types/cookie and drop CookieParseOptions -- the name SvelteKit's own types use; 2.x additionally removes parse/serialize. The pnpm-workspace override keeps the floor at >=0.7.0 for CVE-2024-47764."
		},
		{
			"matchDepNames": ["sveltekit-2"],
			"allowedVersions": "<3",
			"description": "sveltekit-2 is the alias scripts/check-kit-compat.mjs type-checks the kit peer packages against; it must stay on SvelteKit 2 while the peer range admits 2. The workspace's own @sveltejs/kit takes the majors."
		},
		{
			"matchFileNames": ["tools/compose-lib-fixture/kit2/package.json"],
			"matchPackageNames": ["@sveltejs/kit"],
			"allowedVersions": "<3",
			"description": "The kit2 compose fixture builds the docs/compose import forms on the newest SvelteKit 2; it stays on 2 while the kit peer range admits 2. The kit3 fixture takes the majors."
		},
		{
			"matchFileNames": ["tools/compose-lib-fixture/kit2/package.json"],
			"matchPackageNames": ["@sveltejs/adapter-static"],
			"allowedVersions": "<4",
			"description": "adapter-static 4 requires SvelteKit 3; the kit2 compose fixture keeps the last major that runs on SvelteKit 2."
		},
		{
			"matchDepTypes": ["devDependencies"],
			"matchUpdateTypes": ["minor", "patch"],
			"groupName": "devDependencies (non-major)"
		},
		{
			"matchPackageNames": [
				"/eslint/",
				"eslint**",
				"@eslint/**",
				"@typescript-eslint/**",
				"prettier**",
				"@commitlint/**",
				"lint-staged"
			],
			"groupName": "linters and formatters"
		},
		{
			"matchPackageNames": [
				"/vitest/",
				"@vitest/**",
				"@playwright/**",
				"playwright",
				"@testing-library/**",
				"@axe-core/**",
				"jsdom"
			],
			"groupName": "test tooling"
		},
		{
			"matchPackageNames": ["@tanstack/**"],
			"groupName": "tanstack monorepo"
		},
		{
			"matchPackageNames": ["svelte", "@sveltejs/**"],
			"matchUpdateTypes": ["minor", "patch"],
			"groupName": "svelte ecosystem (non-major)"
		},
		{
			"description": "praetor-managed files: praetorctl adopt ships their updates and praetorctl audit locks them byte for byte",
			"matchFileNames": [
				".github/workflows/praetor-docs.yml",
				"tools/markdownlint/package.json",
				"tools/markdownlint/package-lock.json",
				"tools/markdownlint/markdownlint-cli2.yaml",
				"tools/markdownlint/verify.mjs",
				"tools/markdownlint/no-private-scratch-links.mjs",
				"tools/figures/core.mjs",
				"tools/figures/checks.mjs",
				"tools/figures/build.mjs",
				"tools/figures/types.ts",
				"tools/figures/third_party/interfig/vendor.json",
				"tools/figures/third_party/interfig/VENDOR.md",
				"tools/figures/third_party/interfig/upstream/LICENSE",
				"tools/figures/third_party/interfig/upstream/src/svg.ts",
				"tools/figures/third_party/interfig/upstream/src/geometry.ts",
				"tools/figures/third_party/interfig/upstream/src/model.ts",
				"tools/figures/dist/loader.js",
				"tools/figures/dist/player.js",
				"tools/figures/dist/THIRD-PARTY-LICENSES.txt",
				"tools/figures/figures.css",
				"tools/figures/mkdocs_hook.py",
				"tools/figures/astro.mjs",
				"tools/figures/serve.mjs",
				"tools/figures/README.md",
				".devcontainer/devcontainer.json",
				".devcontainer/Dockerfile.praetor",
				".github/workflows/reuse.yml"
			],
			"enabled": false
		}
	]
}
