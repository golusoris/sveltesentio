{
	// Type-checks src and bin together with test, matching every other package's
	// `typecheck` entry point. This one never emits, so widening `include` cannot
	// affect dist/.
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true
	},
	"include": ["src/**/*", "bin/**/*", "test/**/*"]
}
