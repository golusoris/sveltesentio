{
	"dependencies": {
		"@sveltesentio/core": "workspace:*"
	},
	"description": "@xyflow/svelte wrappers — node editors, DAG helpers, canvas utilities",
	"devDependencies": {
		"@storybook/addon-svelte-csf": "5.1.5",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@sveltesentio/testing": "workspace:*",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@xyflow/svelte": "^1.6.6",
		"axe-core": "^4.13.0",
		"elkjs": "^0.12.0",
		"jsdom": "^30.0.0",
		"svelte": "^5.57.0",
		"typescript": "^6.0.3",
		"vitest": "^5.0.0"
	},
	"exports": {
		".": {
			"import": "./src/index.ts",
			"types": "./src/index.ts"
		},
		"./canvas": {
			"types": "./src/canvas.ts",
			"import": "./src/canvas.ts",
			"svelte": "./src/FlowCanvas.svelte"
		},
		"./canvas-model": {
			"import": "./src/canvas-model.ts",
			"types": "./src/canvas-model.ts"
		},
		"./dag": {
			"import": "./src/dag.ts",
			"types": "./src/dag.ts"
		},
		"./layout": {
			"import": "./src/layout.ts",
			"types": "./src/layout.ts"
		},
		"./layout-worker": {
			"import": "./src/layout-worker.ts",
			"types": "./src/layout-worker.ts"
		},
		"./node-palette": {
			"import": "./src/node-palette.ts",
			"types": "./src/node-palette.ts"
		},
		"./nodes": {
			"import": "./src/nodes.ts",
			"types": "./src/nodes.ts"
		}
	},
	"files": [
		"src",
		"CHANGELOG.md",
		"!src/**/*.stories.svelte"
	],
	"keywords": [
		"sveltesentio",
		"flow",
		"node-editor",
		"dag",
		"xyflow"
	],
	"license": "EUPL-1.2",
	"engines": {
		"node": ">=24"
	},
	"name": "@sveltesentio/flow",
	"peerDependencies": {
		"@xyflow/svelte": ">=1.0.0",
		"elkjs": ">=0.11.0",
		"svelte": ">=5.0.0",
		"typescript": ">=5.5 <7"
	},
	"peerDependenciesMeta": {
		"@xyflow/svelte": {
			"optional": true
		}
	},
	"private": false,
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"directory": "packages/flow",
		"type": "git",
		"url": "git+https://github.com/golusoris/sveltesentio.git"
	},
	"scripts": {
		"build": "tsc",
		"lint": "eslint src/",
		"test": "vitest run --coverage",
		"typecheck": "tsc --noEmit -p tsconfig.test.json"
	},
	"sideEffects": false,
	"type": "module",
	"version": "0.6.0"
}
