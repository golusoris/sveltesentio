{
	"dependencies": {
		"@sveltesentio/core": "workspace:*"
	},
	"description": "Server-proxy-only LLM client, on-device transformers seam, and EU AI Act audit hook for SvelteKit",
	"devDependencies": {
		"@storybook/addon-svelte-csf": "5.1.5",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@sveltesentio/core": "workspace:*",
		"@sveltesentio/testing": "workspace:*",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/svelte": "^5.4.2",
		"axe-core": "^4.13.0",
		"jsdom": "^30.0.0",
		"svelte": "^5.57.0",
		"typescript": "^6.0.3",
		"vitest": "^5.0.0",
		"zod": "^4.6.1"
	},
	"exports": {
		".": {
			"import": "./src/index.ts",
			"types": "./src/index.ts"
		},
		"./audit": {
			"import": "./src/audit.ts",
			"types": "./src/audit.ts"
		},
		"./client": {
			"import": "./src/client.svelte.ts",
			"types": "./src/client.svelte.ts"
		},
		"./client/component": {
			"svelte": "./src/ChatStream.svelte",
			"default": "./src/ChatStream.svelte"
		},
		"./edge": {
			"import": "./src/edge.ts",
			"types": "./src/edge.ts"
		},
		"./proxy": {
			"import": "./src/proxy.ts",
			"types": "./src/proxy.ts"
		},
		"./server": {
			"import": "./src/server.ts",
			"types": "./src/server.ts"
		}
	},
	"files": [
		"src",
		"CHANGELOG.md"
	],
	"keywords": [
		"sveltesentio",
		"ai",
		"llm",
		"anthropic",
		"ollama",
		"transformers",
		"edge-ai",
		"eu-ai-act",
		"audit",
		"rfc9457"
	],
	"license": "EUPL-1.2",
	"engines": {
		"node": ">=24"
	},
	"name": "@sveltesentio/ai",
	"peerDependencies": {
		"@anthropic-ai/sdk": ">=0.40.0",
		"@huggingface/transformers": ">=4.1.0",
		"@sveltejs/kit": ">=2.0.0",
		"ollama": ">=0.5.0",
		"svelte": ">=5.0.0",
		"typescript": ">=5.5 <7",
		"zod": ">=4.0.0"
	},
	"peerDependenciesMeta": {
		"@anthropic-ai/sdk": {
			"optional": true
		},
		"@huggingface/transformers": {
			"optional": true
		},
		"ollama": {
			"optional": true
		}
	},
	"private": false,
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"directory": "packages/ai",
		"type": "git",
		"url": "git+https://github.com/golusoris/sveltesentio.git"
	},
	"scripts": {
		"build": "tsc",
		"lint": "eslint src/",
		"test": "vitest run --coverage",
		"typecheck": "tsc --noEmit -p tsconfig.test.json"
	},
	"sideEffects": false,
	"type": "module",
	"version": "0.5.1"
}
