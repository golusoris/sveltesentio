{
  "dependencies": {
    "@sveltesentio/core": "workspace:*"
  },
  "description": "Server-proxy-only LLM client, on-device transformers seam, and EU AI Act audit hook for SvelteKit",
  "devDependencies": {
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@sveltesentio/core": "workspace:*",
    "@sveltesentio/testing": "workspace:*",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/svelte": "^5.4.2",
    "axe-core": "^4.13.0",
    "jsdom": "^29.1.1",
    "svelte": "^5.57.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11",
    "zod": "^4.6.1"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./audit": {
      "import": "./src/audit.ts",
      "types": "./src/audit.ts"
    },
    "./client": {
      "import": "./src/client.svelte.ts",
      "types": "./src/client.svelte.ts"
    },
    "./client/component": {
      "default": "./src/ChatStream.svelte",
      "svelte": "./src/ChatStream.svelte"
    },
    "./edge": {
      "import": "./src/edge.ts",
      "types": "./src/edge.ts"
    },
    "./proxy": {
      "import": "./src/proxy.ts",
      "types": "./src/proxy.ts"
    },
    "./server": {
      "import": "./src/server.ts",
      "types": "./src/server.ts"
    }
  },
  "files": [
    "src",
    "CHANGELOG.md"
  ],
  "keywords": [
    "sveltesentio",
    "ai",
    "llm",
    "anthropic",
    "ollama",
    "transformers",
    "edge-ai",
    "eu-ai-act",
    "audit",
    "rfc9457"
  ],
  "name": "@sveltesentio/ai",
  "peerDependencies": {
    "@anthropic-ai/sdk": "\u003e=0.40.0",
    "@huggingface/transformers": "\u003e=4.1.0",
    "@sveltejs/kit": "\u003e=2.0.0",
    "ollama": "\u003e=0.5.0",
    "svelte": "\u003e=5.0.0",
    "zod": "\u003e=4.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@huggingface/transformers": {
      "optional": true
    },
    "ollama": {
      "optional": true
    }
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "type": "module",
  "version": "0.4.0"
}
