{
  "description": "SSR-safe EmulatorJS loader (Svelte 5 \u003cEmulator\u003e) + platform→core map + strict-CSP additions for WASM/worker cores",
  "devDependencies": {
    "@storybook/addon-svelte-csf": "5.1.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@sveltesentio/testing": "workspace:*",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/svelte": "^5.4.2",
    "axe-core": "^4.13.0",
    "esm-env": "^1.2.2",
    "jsdom": "^29.1.1",
    "svelte": "^5.57.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./Emulator.svelte": {
      "svelte": "./src/Emulator.svelte",
      "types": "./src/Emulator.svelte"
    },
    "./cores": {
      "import": "./src/cores.ts",
      "types": "./src/cores.ts"
    },
    "./csp": {
      "import": "./src/csp.ts",
      "types": "./src/csp.ts"
    },
    "./loader": {
      "import": "./src/loader.ts",
      "types": "./src/loader.ts"
    }
  },
  "files": [
    "src",
    "!src/**/*.stories.svelte",
    "CHANGELOG.md"
  ],
  "keywords": [
    "sveltesentio",
    "emulatorjs",
    "emulator",
    "retro",
    "wasm",
    "csp"
  ],
  "name": "@sveltesentio/emulator",
  "peerDependencies": {
    "esm-env": "\u003e=1.0.0",
    "svelte": "\u003e=5.0.0"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "type": "module",
  "version": "0.1.0"
}
