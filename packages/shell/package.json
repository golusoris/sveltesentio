{
	"description": "Device-class layout + input primitives \u2014 classifyDevice, D-pad/Gamepad focus graph, Tailwind 4 safe-area, optional @vite-pwa/sveltekit registration",
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@playwright/test": "^1.63.0",
		"@sveltesentio/testing": "workspace:*",
		"@types/node": "^24.13.4",
		"svelte": "^5.57.0",
		"typescript": "^7.0.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"exports": {
		".": {
			"import": "./src/index.ts",
			"types": "./src/index.ts"
		},
		"./device-class": {
			"import": "./src/device-class.ts",
			"types": "./src/device-class.ts"
		},
		"./dpad": {
			"import": "./src/dpad-index.ts",
			"types": "./src/dpad-index.ts"
		},
		"./pwa": {
			"import": "./src/pwa.ts",
			"types": "./src/pwa.ts"
		},
		"./safe-area": {
			"import": "./src/safe-area.ts",
			"types": "./src/safe-area.ts"
		}
	},
	"files": [
		"src",
		"CHANGELOG.md"
	],
	"keywords": [
		"sveltesentio",
		"shell",
		"device-class",
		"pwa",
		"10-foot",
		"handheld",
		"d-pad",
		"gamepad",
		"safe-area"
	],
	"name": "@sveltesentio/shell",
	"peerDependencies": {
		"@sveltejs/kit": ">=2.0.0",
		"@vite-pwa/sveltekit": ">=1.1.0",
		"svelte": ">=5.0.0",
		"vite-plugin-pwa": ">=1.2.0"
	},
	"peerDependenciesMeta": {
		"@sveltejs/kit": {
			"optional": true
		},
		"@vite-pwa/sveltekit": {
			"optional": true
		},
		"vite-plugin-pwa": {
			"optional": true
		}
	},
	"private": false,
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc",
		"lint": "eslint src/",
		"test": "vitest run --coverage",
		"test:e2e": "playwright test --config e2e/playwright.config.ts",
		"typecheck": "tsc --noEmit -p tsconfig.test.json"
	},
	"sideEffects": false,
	"type": "module",
	"version": "0.2.0"
}
