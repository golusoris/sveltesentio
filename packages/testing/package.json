{
	"description": "Test helpers: deterministic testClock, a11y lane harness, Superforms + TanStack Query fixtures",
	"devDependencies": {
		"@sveltesentio/core": "workspace:*",
		"typescript": "^6.0.3",
		"vitest": "^5.0.0"
	},
	"exports": {
		".": {
			"import": "./src/index.ts",
			"types": "./src/index.ts"
		},
		"./a11y": {
			"import": "./src/a11y.ts",
			"types": "./src/a11y.ts"
		},
		"./clock": {
			"import": "./src/clock.ts",
			"types": "./src/clock.ts"
		},
		"./fixtures": {
			"import": "./src/fixtures.ts",
			"types": "./src/fixtures.ts"
		},
		"./playwright-axe": {
			"import": "./src/playwright-axe.ts",
			"types": "./src/playwright-axe.ts"
		}
	},
	"files": [
		"src",
		"CHANGELOG.md"
	],
	"keywords": [
		"sveltesentio",
		"testing",
		"vitest",
		"a11y",
		"clock"
	],
	"license": "EUPL-1.2",
	"name": "@sveltesentio/testing",
	"peerDependencies": {
		"@sveltesentio/core": "workspace:*",
		"vitest": ">=4.0.0"
	},
	"peerDependenciesMeta": {
		"vitest": {
			"optional": true
		}
	},
	"private": false,
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"directory": "packages/testing",
		"type": "git",
		"url": "git+https://github.com/golusoris/sveltesentio.git"
	},
	"scripts": {
		"build": "tsc",
		"lint": "eslint src/",
		"test": "vitest run --coverage",
		"typecheck": "tsc --noEmit -p tsconfig.test.json"
	},
	"sideEffects": false,
	"type": "module",
	"version": "0.2.0"
}
