{
	"dependencies": {
		"@sveltesentio/core": "workspace:*",
		"esm-env": "^1.2.2"
	},
	"description": "Media player (headless HLS model + a11y <Player> shell), responsive blur-up <Image>, and a preset-aware embla <Carousel> — Svelte 5",
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@storybook/addon-svelte-csf": "5.1.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@sveltesentio/core": "workspace:*",
		"@testing-library/jest-dom": "^6.10.0",
		"@testing-library/svelte": "^5.4.2",
		"axe-core": "^4.13.0",
		"jsdom": "^29.1.1",
		"svelte": "^5.57.0",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"exports": {
		".": {
			"import": "./src/index.ts",
			"types": "./src/index.ts"
		},
		"./carousel": {
			"import": "./src/carousel.ts",
			"types": "./src/carousel.ts"
		},
		"./carousel/component": {
			"svelte": "./src/Carousel.svelte",
			"default": "./src/Carousel.svelte"
		},
		"./image": {
			"import": "./src/image.ts",
			"types": "./src/image.ts"
		},
		"./image/component": {
			"svelte": "./src/Image.svelte",
			"default": "./src/Image.svelte"
		},
		"./image/lqip": {
			"import": "./src/lqip.ts",
			"types": "./src/lqip.ts"
		},
		"./player": {
			"import": "./src/player.ts",
			"types": "./src/player.ts"
		},
		"./player/component": {
			"svelte": "./src/Player.svelte",
			"default": "./src/Player.svelte"
		},
		"./player/controls": {
			"import": "./src/player-controls.ts",
			"types": "./src/player-controls.ts"
		}
	},
	"files": [
		"src",
		"CHANGELOG.md",
		"!src/**/*.stories.svelte"
	],
	"keywords": [
		"sveltesentio",
		"media",
		"hls",
		"player",
		"carousel",
		"image",
		"srcset",
		"media-session",
		"10-foot-ui"
	],
	"name": "@sveltesentio/media",
	"peerDependencies": {
		"embla-carousel-svelte": ">=8.6.0",
		"hls.js": ">=1.6.0",
		"svelte": ">=5.0.0",
		"vidstack": ">=1.12.13 <2"
	},
	"peerDependenciesMeta": {
		"embla-carousel-svelte": {
			"optional": true
		},
		"hls.js": {
			"optional": true
		},
		"vidstack": {
			"optional": true
		}
	},
	"private": false,
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc",
		"lint": "eslint src/",
		"test": "vitest run --coverage",
		"test:e2e": "playwright test --config e2e/playwright.config.ts",
		"typecheck": "tsc --noEmit -p tsconfig.test.json"
	},
	"sideEffects": false,
	"type": "module",
	"version": "0.5.0"
}
