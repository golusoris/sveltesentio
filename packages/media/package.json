{
  "dependencies": {
    "@sveltesentio/core": "workspace:*",
    "esm-env": "^1.2.2"
  },
  "description": "Media player (headless HLS model + a11y \u003cPlayer\u003e shell), responsive blur-up \u003cImage\u003e, and a preset-aware embla \u003cCarousel\u003e — Svelte 5",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@storybook/addon-svelte-csf": "5.1.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@sveltesentio/core": "workspace:*",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/svelte": "^5.4.2",
    "axe-core": "^4.13.0",
    "jsdom": "^29.1.1",
    "svelte": "^5.57.0",
    "typescript": "^5.7.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./carousel": {
      "import": "./src/carousel.ts",
      "types": "./src/carousel.ts"
    },
    "./carousel/component": {
      "default": "./src/Carousel.svelte",
      "svelte": "./src/Carousel.svelte"
    },
    "./image": {
      "import": "./src/image.ts",
      "types": "./src/image.ts"
    },
    "./image/component": {
      "default": "./src/Image.svelte",
      "svelte": "./src/Image.svelte"
    },
    "./image/lqip": {
      "import": "./src/lqip.ts",
      "types": "./src/lqip.ts"
    },
    "./player": {
      "import": "./src/player.ts",
      "types": "./src/player.ts"
    },
    "./player/component": {
      "default": "./src/Player.svelte",
      "svelte": "./src/Player.svelte"
    },
    "./player/controls": {
      "import": "./src/player-controls.ts",
      "types": "./src/player-controls.ts"
    }
  },
  "files": [
    "src",
    "CHANGELOG.md",
    "!src/**/*.stories.svelte"
  ],
  "keywords": [
    "sveltesentio",
    "media",
    "hls",
    "player",
    "carousel",
    "image",
    "srcset",
    "media-session",
    "10-foot-ui"
  ],
  "name": "@sveltesentio/media",
  "peerDependencies": {
    "embla-carousel-svelte": "\u003e=8.6.0",
    "hls.js": "\u003e=1.6.0",
    "svelte": "\u003e=5.0.0",
    "vidstack": "\u003e=1.12.13 \u003c2"
  },
  "peerDependenciesMeta": {
    "embla-carousel-svelte": {
      "optional": true
    },
    "hls.js": {
      "optional": true
    },
    "vidstack": {
      "optional": true
    }
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "type": "module",
  "version": "0.4.1"
}
