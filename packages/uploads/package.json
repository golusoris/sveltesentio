{
	"dependencies": {
		"@sveltesentio/core": "workspace:*",
		"exifr": "^7.1.3",
		"file-type": "^22.0.2"
	},
	"description": "Resumable uploads — tus-js-client + exifr (EXIF strip) + file-type (magic-byte sniffing)",
	"devDependencies": {
		"tus-js-client": "^4.3.1",
		"typescript": "^6.0.3",
		"vitest": "^5.0.0"
	},
	"exports": {
		".": {
			"import": "./src/index.ts",
			"types": "./src/index.ts"
		},
		"./exif": {
			"import": "./src/exif.ts",
			"types": "./src/exif.ts"
		},
		"./resumable": {
			"import": "./src/resumable.ts",
			"types": "./src/resumable.ts"
		},
		"./validate": {
			"import": "./src/validate.ts",
			"types": "./src/validate.ts"
		}
	},
	"files": [
		"src",
		"CHANGELOG.md"
	],
	"keywords": [
		"sveltesentio",
		"uploads",
		"tus",
		"exifr",
		"file-type",
		"resumable"
	],
	"license": "EUPL-1.2",
	"engines": {
		"node": ">=24"
	},
	"name": "@sveltesentio/uploads",
	"peerDependencies": {
		"tus-js-client": ">=4.3.0",
		"typescript": ">=5.5 <7"
	},
	"peerDependenciesMeta": {
		"tus-js-client": {
			"optional": true
		}
	},
	"private": false,
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"directory": "packages/uploads",
		"type": "git",
		"url": "git+https://github.com/golusoris/sveltesentio.git"
	},
	"scripts": {
		"build": "tsc",
		"lint": "eslint src/ test/",
