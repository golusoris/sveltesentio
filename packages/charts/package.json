{
	"description": "Thin LayerChart wrappers with a WCAG 2.2 AA accessibility envelope (ChartFigure) and dashboard presets",
	"devDependencies": {
		"@storybook/addon-svelte-csf": "5.1.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/svelte": "^5.4.2",
		"axe-core": "^4.13.0",
		"jsdom": "^30.0.0",
		"layerchart": "2.5.0",
		"svelte": "^5.57.0",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vitest": "^5.0.0"
	},
	"exports": {
		".": {
			"import": "./src/index.ts",
			"types": "./src/index.ts"
		},
		"./a11y-table": {
			"import": "./src/a11y-table.ts",
			"types": "./src/a11y-table.ts"
		},
		"./area": {
			"svelte": "./src/AreaChart.svelte",
			"default": "./src/AreaChart.svelte"
		},
		"./bar": {
			"svelte": "./src/BarChart.svelte",
			"default": "./src/BarChart.svelte"
		},
		"./chart": {
			"svelte": "./src/Chart.svelte",
			"default": "./src/Chart.svelte"
		},
		"./chart-series": {
			"import": "./src/chart-series.ts",
			"types": "./src/chart-series.ts"
		},
		"./figure": {
			"svelte": "./src/ChartFigure.svelte",
			"default": "./src/ChartFigure.svelte"
		},
		"./line": {
			"svelte": "./src/LineChart.svelte",
			"default": "./src/LineChart.svelte"
		},
		"./palette": {
			"import": "./src/palette.ts",
			"types": "./src/palette.ts"
		},
		"./pie": {
			"svelte": "./src/PieChart.svelte",
			"default": "./src/PieChart.svelte"
		},
		"./preset": {
			"import": "./src/preset.ts",
			"types": "./src/preset.ts"
		},
		"./scatter": {
			"svelte": "./src/ScatterChart.svelte",
			"default": "./src/ScatterChart.svelte"
		},
		"./uplot": {
			"import": "./src/uplot.ts",
			"types": "./src/uplot.ts"
		}
	},
	"files": [
		"src",
		"CHANGELOG.md",
		"!src/**/*.stories.svelte"
	],
	"keywords": [
		"sveltesentio",
		"charts",
		"layerchart",
		"dashboard",
		"accessibility",
		"data-visualization"
	],
	"name": "@sveltesentio/charts",
	"peerDependencies": {
		"layerchart": ">=2.0.0-next.43",
		"svelte": ">=5.0.0",
		"uplot": ">=1.6.0"
	},
	"peerDependenciesMeta": {
		"layerchart": {
			"optional": true
		},
		"uplot": {
			"optional": true
		}
	},
	"private": false,
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc",
		"lint": "eslint src/",
		"test": "vitest run --coverage",
		"typecheck": "tsc --noEmit -p tsconfig.test.json"
	},
	"sideEffects": false,
	"type": "module",
	"version": "0.5.0"
}
