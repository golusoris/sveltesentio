{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "true"
					},
					{
						"type": "command",
						"command": "praetorctl hook claude pre-tool",
						"timeout": 15
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": "prettier --check \"$FILE\" 2>/dev/null || true"
					}
				]
			}
		],
		"PreCommit": [
			{
				"type": "command",
				"command": "make ci"
			}
		]
	}
}
