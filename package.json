{
	"name": "sveltesentio",
	"private": true,
	"license": "EUPL-1.2",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/golusoris/sveltesentio.git"
	},
	"type": "module",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"lint": "turbo lint",
		"lint:root": "eslint . && prettier --check .",
		"typecheck": "turbo typecheck",
		"test": "turbo test",
		"test:e2e": "turbo test:e2e",
		"test:stories": "pnpm --filter @sveltesentio/storybook run test:stories",
		"ci": "turbo lint typecheck test build",
		"check:exports": "node scripts/check-export-targets.mjs",
		"check:publint": "status=0; for dir in packages/*/; do node_modules/.bin/publint --strict \"$dir\" || status=1; done; exit $status",
		"check:svelte": "status=0; for dir in packages/*/; do if find \"$dir\" -name node_modules -prune -o -name '*.svelte' -print | grep -q .; then node_modules/.bin/svelte-check --workspace \"$dir\" --tsconfig ./tsconfig.test.json --fail-on-warnings || status=1; fi; done; exit $status",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check:cycles": "node scripts/check-import-cycles.mjs",
		"check:kit-compat": "node scripts/check-kit-compat.mjs",
		"lint:scripts": "eslint scripts/",
		"test:scripts": "ls scripts/*.test.mjs > /dev/null && node --test \"scripts/*.test.mjs\""
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@eslint/js": "^10.0.1",
		"@sveltesentio/core": "workspace:*",
		"@typescript-eslint/eslint-plugin": "^8.70.0",
		"@typescript-eslint/parser": "^8.70.0",
		"@vitest/coverage-v8": "^5.0.0",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"publint": "^0.3.25",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.8.1",
		"sveltekit-3": "npm:@sveltejs/kit@3.0.1",
		"turbo": "^2.10.12",
		"typescript": "^6.0.3"
	},
	"lint-staged": {
		"*.{ts,svelte,js}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md,yaml,yml,css,html}": [
			"prettier --write"
		]
	},
	"engines": {
		"node": ">=22",
		"pnpm": ">=10"
	},
	"packageManager": "pnpm@12.11.2"
}
